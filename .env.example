# Banco de dados PostgreSQL
POSTGRES_DB=ecommerce_db
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=postgres_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Cache em Redis
REDIS_PASSWORD=redis_password
REDIS_HOST=redis
REDIS_PORT=6379
## Tempo em minutos para a expiração dos dados
REDIS_TIMEOUT=720

# Configuração do ambiente do servidor 
TIMEZONE=America/Sao_Paulo

# Configuração do JWT
## Defina uma chave segura
JWT_SECRET=jwt_secret_key
TOKEN_ISSUER=ecommerce
## Tempo em horas que o token ficará ativo
TOKEN_EXPIRATION_HOURS=2

# Configuração dos endpoints do Front-End
FRONT_ENDPOINTS=http://127.0.0.1:5500;http://localhost:5500