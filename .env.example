# App Configuration
TIMEZONE=America/Sao_Paulo

# Database (PostgreSQL - Ecommerce)
POSTGRES_DB=ecommerce_db
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=postgres_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Cache (Redis - Ecommerce)
REDIS_PASSWORD=redis_password
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_TIMEOUT=720 # Tempo em minutos para a expiração dos dados

# Security (JWT - Ecommerce)
JWT_SECRET=jwt_secret_key # Defina uma chave segura
TOKEN_ISSUER=ecommerce
TOKEN_EXPIRATION_HOURS=2 # Tempo em horas que o token ficará ativo

# CORS / Infrastructure
FRONT_ENDPOINTS=http://127.0.0.1:5500;http://localhost:5500